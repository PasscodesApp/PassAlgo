{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
    },
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,

    "declaration": true,
    "declarationMap": true,

    "outDir": "dist",
    "rootDir": "src",

    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
