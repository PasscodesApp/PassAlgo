{
    "name": "@passcodes/passalgo",
    "version": "0.2.0",
    "description": "Shared algorithms and utilities used across Passcodes applications.",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "private": "false",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        },
        "./passwords": {
            "types": "./dist/passwords/index.d.ts",
            "import": "./dist/passwords/index.js",
            "require": "./dist/passwords/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist",
        "prepare": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PasscodesApp/PassAlgo.git"
    },
    "keywords": [],
    "author": "Jeel Dobariya (https://github.com/JeelDobariya38)",
    "license": "MIT",
    "type": "module",
    "bugs": {
        "url": "https://github.com/PasscodesApp/PassAlgo/issues"
    },
    "homepage": "https://github.com/PasscodesApp/PassAlgo#readme",
    "devDependencies": {
        "typescript": "^7.0.2"
    }
}
